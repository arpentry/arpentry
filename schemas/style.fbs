namespace arpentry.tiles;
file_identifier "arps";
file_extension "arps";

struct RGBA {
  r: uint8;
  g: uint8;
  b: uint8;
  a: uint8;
}

table PaintEntry {
  class:        string (required);  // class value to match ("water", "primary", ...)
  color:        RGBA;               // fill or line color
  width:        float32;            // line half-width in quantized units (0 for fills)
  model:        string;             // model name in ModelLibrary (e.g. "broadleaf_01")
  min_scale:    float32 = 1.0;     // instance scale range lower bound
  max_scale:    float32 = 1.0;     // instance scale range upper bound
  random_yaw:   bool = true;       // apply random yaw rotation per instance
  random_scale: bool = true;       // apply random scale variation per instance
  min_level:    uint8 = 0;          // skip features of this class below this zoom level
}

enum LayerType : uint8 { Terrain = 0, Texture = 1, Extrusion = 2, Instance = 3, Label = 4, Line = 5 }

table LayerStyle {
  source_layer:   string (required);  // tile layer name ("surface", "transportation", ...)
  type:           LayerType = Texture; // how to render this layer
  min_level:      uint8 = 0;          // skip decoding below this zoom level
  paint:          [PaintEntry];       // class -> visual properties
  text_size:      float32 = 14.0;    // label text size in pixels
  text_color:     RGBA;              // label text fill color
  text_halo_color:RGBA;              // label text halo color
  text_halo_width:float32 = 2.0;    // label text halo width in pixels
  icon_size:      float32 = 20.0;   // label icon size in pixels
  icon_color:     RGBA;              // label icon fill color
  icon_halo_color:RGBA;              // label icon halo color
  icon_halo_width:float32 = 0.5;    // label icon halo width in pixels
}

table Style {
  version:      uint16 = 1;
  name:         string;
  background:   RGBA;               // fallback for unmatched classes
  layers:       [LayerStyle];
}

root_type Style;
